node_modules/
*.log
.DS_Store

# Test-only React 18 install for tools/interaction-check.mjs; never a runtime
# dependency (the host supplies React at load time).
tools/.react/
.react18/

# Local scratch: probe output, screenshots and preview pages produced by
# tools/*.mjs land here, not in the repository. The curated screenshots that
# ship live in assets/screenshots/ and are declared in screenshots.json.
.tmp/
.preview/
.acl-recovery/

# The tapd CLI writes ./.tapd.json into its working directory; never commit it.
.tapd.json

# Local build artifacts and dev captures: tarballs ship via GitHub releases,
# screenshots/probe logs are throwaway.
dsh-glass-theme-*.tgz
out/
.probe/
.shot/

# Local agent skill checkouts; the openspec skills live here, not in the repo.
.dsh/
